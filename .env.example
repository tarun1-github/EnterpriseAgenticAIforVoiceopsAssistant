# =====================================================================
# VoiceOps AI - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.
# =====================================================================

# --- LLM Provider Settings ---
# Options: openai, gemini, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Provider-specific keys and endpoints
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OLLAMA_BASE_URL=http://localhost:11434

# --- Application & Logging ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Cisco CUCM 15.0 Configuration (Future live integration) ---
CUCM_HOST=
CUCM_PORT=8443
CUCM_USERNAME=
CUCM_PASSWORD=
CUCM_VERIFY_SSL=false

# --- Cisco CUCM SSH/CLI Configuration (for trace collection) ---
CUCM_SSH_PORT=22
CUCM_SSH_USERNAME=
CUCM_SSH_PASSWORD=
CUCM_SSH_TIMEOUT=30
CUCM_COMMAND_TIMEOUT=60
CUCM_PROMPT_TIMEOUT=15

# --- Cisco Voice Gateway Configuration (Future live integration) ---
GATEWAY_HOST=
GATEWAY_USERNAME=
GATEWAY_PASSWORD=
GATEWAY_SSH_PORT=22
